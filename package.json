{
  "name": "reuseproof-ca-core",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only evidence-domain foundation for ReuseProof CA.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "npm run build --silent && node dist/scripts/demo.js fixtures/demo.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene": "node scripts/check-hygiene.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
