{
  "name": "reuseproof-ca-core",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only evidence-domain foundation for ReuseProof CA.",
  "type": "module",
  "bin": {
    "reuseproof-verify": "bin/reuseproof-verify.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:concurrency": "node scripts/check-workflow-concurrency.mjs",
    "check:pins": "node scripts/check-workflow-pins.mjs",
    "demo": "npm run build --silent && node dist/scripts/demo.js fixtures/reconciled-demo.json",
    "demo:check": "node dist/scripts/demo.js fixtures/reconciled-demo.json > /dev/null",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene": "node scripts/check-hygiene.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:cli": "npm run build --silent && node bin/reuseproof-verify.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
